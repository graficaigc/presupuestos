# Base de datos Postgres (ej. connection string de Neon.tech, gratis)
DATABASE_URL="postgresql://usuario:password@host/basededatos?sslmode=require"

# Servidor
PORT=3000

# Autenticación: cualquier cadena larga y secreta (cambiarla en producción)
JWT_SECRET="cambiar-esto-por-una-cadena-larga-y-aleatoria"

# Duración de la prueba gratuita en días
TRIAL_DAYS=14

# Lemon Squeezy (crear cuenta en https://app.lemonsqueezy.com)
# API_KEY: Settings > API. STORE_ID: Settings > Stores. VARIANT_ID: el ID de la
# variante del producto de suscripción mensual que crees en tu tienda.
# WEBHOOK_SECRET: lo definís vos al crear el webhook en Settings > Webhooks.
LEMONSQUEEZY_API_KEY="ls_..."
LEMONSQUEEZY_STORE_ID="..."
LEMONSQUEEZY_VARIANT_ID="..."
LEMONSQUEEZY_WEBHOOK_SECRET="..."

# URL pública del sitio (usada para redirects del checkout)
APP_URL="http://localhost:3000"
